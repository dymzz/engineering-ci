{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-ci.local/schemas/ghwf-state-v2.json",
  "title": "ghwf execution checkpoint v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dispatch", "collection", "phase", "run_id", "paused_from", "remote_status", "remote_conclusion", "collection_complete", "files", "last_error", "http_status", "updated_at", "dispatch_started_at"],
  "properties": {
    "schema_version": {"const": 2},
    "dispatch": {
      "type": "object", "additionalProperties": false,
      "required": ["repo", "workflow", "ref", "inputs_sha256"],
      "properties": {
        "repo": {"type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$"},
        "workflow": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "inputs_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "collection": {
      "type": "object", "additionalProperties": false,
      "required": ["out", "artifact", "save_log", "no_artifacts"],
      "properties": {
        "out": {"type": "string", "minLength": 1},
        "artifact": {"type": ["string", "null"]},
        "save_log": {"type": "boolean"},
        "no_artifacts": {"type": "boolean"}
      }
    },
    "phase": {"enum": ["INIT", "VALIDATED", "DISPATCHING", "UNKNOWN", "REJECTED", "RUNNING", "COLLECTING", "PAUSED", "FINISHED"]},
    "run_id": {"type": ["integer", "null"], "minimum": 1},
    "paused_from": {"enum": ["RUNNING", "COLLECTING", null]},
    "remote_status": {"type": ["string", "null"]},
    "remote_conclusion": {"type": ["string", "null"]},
    "collection_complete": {"type": "boolean"},
    "files": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "plans": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "additionalProperties": false,
            "required": ["keys", "artifacts_listed"],
            "properties": {
              "keys": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
              "artifacts_listed": {"type": "boolean"},
              "run_attempt": {"type": "integer", "minimum": 1}
            }
          }
        },
        "outputs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/fileOutput"}},
        "legacy": {
          "type": "object", "additionalProperties": false,
          "required": ["collection", "log_saved", "artifacts_saved", "artifact_files"],
          "properties": {
            "collection": {"$ref": "#/properties/collection"},
            "log_saved": {"type": "boolean"},
            "artifacts_saved": {"type": "boolean"},
            "artifact_files": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "last_error": {"type": ["string", "null"]},
    "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
    "updated_at": {"type": "string", "format": "date-time"},
    "dispatch_started_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "$defs": {
    "resource": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "size", "digest", "immutable"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "size": {"type": ["integer", "null"], "minimum": 0},
        "digest": {"type": ["string", "null"]},
        "immutable": {"type": "boolean"}
      }
    },
    "fileOutput": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "required", "status", "manifest"],
      "properties": {
        "kind": {"enum": ["log", "artifact"]},
        "required": {"type": "boolean"},
        "status": {"enum": ["pending", "complete", "optional_missing"]},
        "resource": {"$ref": "#/$defs/resource"},
        "manifest": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "complete"}}}, "then": {"required": ["resource"], "properties": {"manifest": {"minProperties": 1}}}},
        {"if": {"properties": {"status": {"const": "optional_missing"}}}, "then": {"properties": {"required": {"const": false}}}}
      ]
    }
  },
  "allOf": [
    {"if": {"properties": {"phase": {"enum": ["RUNNING", "COLLECTING", "PAUSED", "FINISHED"]}}}, "then": {"properties": {"run_id": {"type": "integer", "minimum": 1}}}},
    {"if": {"properties": {"phase": {"const": "PAUSED"}}}, "then": {"properties": {"paused_from": {"enum": ["RUNNING", "COLLECTING"]}}}},
    {"if": {"properties": {"phase": {"enum": ["COLLECTING", "FINISHED"]}}}, "then": {"properties": {"remote_status": {"const": "completed"}, "remote_conclusion": {"type": "string", "minLength": 1}}}},
    {"if": {"properties": {"phase": {"const": "FINISHED"}}}, "then": {"properties": {"collection_complete": {"const": true}}}}
  ]
}
