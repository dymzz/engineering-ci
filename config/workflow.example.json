{
  "schema_version": 1,
  "kind": "workflow-recipe",
  "steps": [
    {
      "id": "lint",
      "tool": "python.ruff-lint",
      "inputs": {"executor": "auto"}
    },
    {
      "id": "inspect-lint",
      "tool": "engineering-ci.check-inspect",
      "inputs": {"report": {"$from": "lint", "pointer": "/report"}},
      "when": "always"
    }
  ]
}
